<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <!--
      IMPORTANT: CONTPAQi SDK is a 32-bit native DLL. The consumer process
      MUST be 32-bit. Do NOT set PlatformTarget=AnyCPU or x64 — BadImageFormatException
      will occur at load time when the runtime tries to LoadLibrary the SDK.
    -->

    <!--
      Single-file self-contained publish (0.11.1): en vez de un directorio con
      200+ archivos (DLLs de runtime .NET + deps de NuGet + native libs), el
      publish produce UN solo EXE + appsettings.json. Beatriz descomprime el
      zip y ve 3-4 archivos en vez de una selva.
        - SelfContained: incluye el runtime .NET 8; no requiere instalar .NET
          en la PC del cliente.
        - IncludeAllContentForSelfExtract: garantiza que Serilog (que carga
          sinks por reflection) encuentre sus DLLs al arranque.
        - EnableCompressionInSingleFile: baja el EXE de ~90 MB a ~40 MB.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <!--
      IncludeNativeLibrariesForSelfExtract (no IncludeAllContent): bundleamos
      DLLs managed + native (SqlClient SNI) dentro del EXE, pero DEJAMOS
      appsettings.json como archivo suelto para que un admin lo pueda editar
      sin recompilar. La config builder lee appsettings.json y appsettings.local.json
      desde exeDir, ambos sueltos.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!--
      Trimming está apagado a propósito: Serilog.Settings.Configuration usa
      reflection para materializar sinks desde el JSON; el trimmer los podaría.
      Si se quiere reducir más el tamaño, migrar a Serilog fluent API primero.
    -->
    <PublishTrimmed>false</PublishTrimmed>

    <!--
      Branding: metadata visible en Task Manager, Explorer (Propiedades → Detalles),
      SCM y el installer Inno Setup. La versión aquí debe matchear
      installer/BillingWriter.iss AppVersion.
    -->
    <ApplicationIcon>centinelia.ico</ApplicationIcon>
    <Product>Centinelia Writer</Product>
    <AssemblyTitle>Centinelia Writer for CONTPAQi</AssemblyTitle>
    <AssemblyName>BillingContpaqiWriter</AssemblyName>
    <Company>Centinelia</Company>
    <Description>Puente entre CONTPAQi Comercial Pro y Centinelia — sincroniza catálogos y timbra CFDIs generados por Nala.</Description>
    <Copyright>© 2026 Centinelia</Copyright>
    <Version>0.11.1</Version>
    <AssemblyVersion>0.11.1.0</AssemblyVersion>
    <FileVersion>0.11.1.0</FileVersion>
    <!--
      Cambios 0.11.1 (2026-09-08):
      * Dry-run antes de instalar: al doble-click el writer verifica MGWServicios.dll,
        carpeta de empresa, SQL Server, y usuario+password+empresa CONTPAQi.
        Si algo falla, muestra qué campo está mal y qué corregir en el portal.
        NO persiste appsettings.local.json ni registra servicio si falla —
        Beatriz reintenta limpio hasta que todo pase.

      Cambios 0.11.0 (2026-09-08):
      * Zero-fricción real: el portal captura empresa CONTPAQi, SQL, SUPERVISOR,
        CSD, concepto y SDK path (setup-contpaqi). El zip trae todo cifrado y
        el writer se auto-configura al arrancar. Doble-click al EXE → resumen
        + prompt "arrancar con Windows" + UAC. Tres Enters/clicks totales.
      * FirstRunWizard CLI queda como fallback si el portal no llenó los
        campos (o zip generado por versiones anteriores).
      * Config passwords vienen descifradas del endpoint autenticado, se
        persisten en appsettings.local.json local (protegido por ACLs).

      Cambios 0.10.6 (2026-09-08):
      * Default mode "service" (antes "session"): doble-click al EXE dispara
        el FirstRunWizard sin necesidad de abrir PowerShell ni pasar flags.
        Los modos smoke (session/find/create/stamp/watch) siguen disponibles
        con mode explícito.
      * Publish single-file self-contained: el zip pasa de ~200 archivos a
        3-4 (EXE + appsettings + LEEME + centinelia-config). Sin fricción
        visual al descomprimir.
      * Auto-install como Windows Service al final del wizard (relaunch con
        UAC + sc create + sc start). Cero comandos manuales para Beatriz.
      * Pausa "presiona una tecla" cuando el wizard o el host fallan en modo
        interactivo. Antes la ventana se cerraba sin dejar leer el error.

      Cambios 0.10.5 (2026-09-08):
      - Wizard interactivo de primer arranque (FirstRunWizard).
      - Loader de centinelia-config.json que inyecta el zip.
      - DropboxTokenFetcher: canjea api_token por access_token via API.
      - Branding en metadata + icono Centinelia.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="Dropbox.Api" Version="7.0.0" />
    <!--
      SQL client para lookups directos a la BD CONTPAQi (RFC→código cliente,
      idDocumento→folio). El SDK no expone esas queries.
    -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!--
      Hosting infra para el modo service (BillingWriter.exe mode service):
      Windows Service integrado con SCM, graceful shutdown, binding de
      appsettings.json.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <!--
      Serilog para file logging con rotación diaria + Event Viewer cuando corre
      como Windows Service. Console sigue disponible en modo dev.
    -->
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      appsettings.json (defaults base) y appsettings.Production.json (overrides
      prod) van sueltos junto al EXE en publish. appsettings.Development.json
      es solo local, no lo publicamos.
    -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="appsettings.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
