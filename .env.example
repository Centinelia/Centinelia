# ═══════════════════════════════════════════════════════════════════
# CENTINELIA — Environment Variables (Template)
# Copy to .env.local and fill in actual values for local development.
# ═══════════════════════════════════════════════════════════════════

# ─── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ─── Auth & session secrets ────────────────────────────────────────
ADMIN_SECRET=
PORTAL_SESSION_SECRET=
CRON_SECRET=
# ENCRYPTION_KEY: encripta refresh_tokens OAuth en DB. NO rotar sin plan de re-auth.
ENCRYPTION_KEY=

# ─── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key — safe to expose. Used by RLS regression tests.
# Get from Supabase dashboard: Project Settings > API > Project API keys > anon public.
SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard

# ─── AI (LLM) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Vapi (voz + orquestación) ─────────────────────────────────────
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_SERVER_SECRET=
DEMO_AGENT_ID=
DEMO_PERSONALIZADO_AGENT_ID=
# IDs de agentes habilitados durante piloto de auto-mode classifier.
# El gate se remueve en Deploy 2 y ambas envs pasan a ser opcionales.
# NIA (voz-only) originalmente; SOFIA (oficina) es la que realmente prueba el flujo de correo.
NEXT_PUBLIC_NIA_DEMO_AGENT_ID=
NEXT_PUBLIC_SOFIA_DEMO_AGENT_ID=
# UUID del voice_agent de Nelia en la org Meefi (demo 15-sept).
# Ver script: scripts/provision-meefi-nelia.ts
MEEFI_NELIA_AGENT_ID=

# ─── ElevenLabs (voces) ────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
VOICE_ALLOWLIST=

# ─── Twilio (WhatsApp + provisioning números MX) ───────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
TWILIO_REGULATORY_BUNDLE_SID=

# ─── Landing callback E2E tests ────────────────────────────────────
# Cuando esta variable esta seteada, verifyOtp acepta este codigo sin
# validar hash. NUNCA setear en produccion. Solo para tests E2E locales.
# Tambien requiere: TWILIO_ACCOUNT_SID=mock TWILIO_AUTH_TOKEN=mock VAPI_API_KEY=mock
LANDING_OTP_MOCK_CODE=
# Email del portal de la org de demo (para que triggerLandingDemoCall resuelva el agente)
LANDING_DEMO_PORTAL_EMAIL=

# ─── Email ─────────────────────────────────────────────────────────
# Inbound (Resend inbound → webhook)
EMAIL_INBOUND_SECRET=
EMAIL_INBOX_DOMAIN=
# Outbound (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Stripe (billing) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Setup fee (one-time)
STRIPE_SETUP_PRO=
# Jornada Combinada (min + tareas) — starter 250+300, growth 500+600, scale 1000+1200
STRIPE_COMBINADA_STARTER=
STRIPE_COMBINADA_GROWTH=
STRIPE_COMBINADA_SCALE=
# Jornada Minutos (voz-heavy) — starter 500+20, growth 900+20, scale 1800+20
STRIPE_MINUTOS_STARTER=
STRIPE_MINUTOS_GROWTH=
STRIPE_MINUTOS_SCALE=
# Jornada Tareas (ops-heavy sin voz) — starter 500, growth 1200, scale 3000
STRIPE_TAREAS_STARTER=
STRIPE_TAREAS_GROWTH=
STRIPE_TAREAS_SCALE=
# Plan Nox (rol Coordinador sin voz — Nox/Niva) — 500/1200/3000 ops
STRIPE_NOX_STARTER=
STRIPE_NOX_GROWTH=
STRIPE_NOX_SCALE=
# LEGACY (deprecated, fallback para combinada mientras Vercel se actualiza)
# Retirar cuando STRIPE_COMBINADA_* esté poblado en prod.
STRIPE_PRO_STARTER=
STRIPE_PRO_GROWTH=
STRIPE_PRO_SCALE=

# ─── Meta (Instagram Graph API) ───────────────────────────────────
# OAuth app credentials from developers.facebook.com/apps.
# Per-user access_token is stored in social_accounts.access_token (DB row).
# Scopes required: instagram_basic, instagram_content_publish, instagram_manage_comments,
#   instagram_manage_insights, pages_read_engagement
META_APP_ID=
META_APP_SECRET=

# ─── OAuth integrations ────────────────────────────────────────────
# Canva Connect API (Navi — brand templates, autofill, export, asset upload)
# Obtener en: https://www.canva.com/developers/apps → Create App → OAuth 2.0 credentials
# Scopes requeridos: design:content:read, design:content:write, asset:read, asset:write,
#   brandtemplate:content:read, brandtemplate:meta:read
# Callback URL: https://<APP_URL>/api/auth/canva-callback
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Google (Gmail + Drive + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft (Outlook + OneDrive + Calendar)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=
# Intuit / QuickBooks
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=

# ─── Search & rate limiting ───────────────────────────────────────
BRAVE_SEARCH_API_KEY=
# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Analytics ─────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=

# ─── Auto-mode classifier (kill switch global) ────────────────────
# Cuando =false, todos los agentes caen a modo 'off' (aprobación humana).
# Setear en Vercel Environment Variables para kill panic. Ver runbook:
# docs/runbooks/auto-mode-classifier.md
AUTO_MODE_CLASSIFIER_ENABLED=

# ─── Vercel (auto-managed) ─────────────────────────────────────────
# VERCEL_OIDC_TOKEN se refresca con `vercel link` / `vercel env pull`. No editar a mano.
VERCEL_OIDC_TOKEN=

# ─── Google Sheets E2E integration tests (optional) ────────────────
# Optional: set to enable Google Sheets E2E integration tests against a real spreadsheet in centinelia.dev@gmail.com
# Leave blank to skip the E2E suite gracefully (CI-safe, dev-safe).
# Prerequisite: create "Centinelia Test Sheet" in centinelia.dev@gmail.com Drive with a tab
# named "Clientes" and headers: Nombre | Telefono | Email in row 1.
TEST_PORTAL_EMAIL=
TEST_SPREADSHEET_ID=
TEST_TAB=
