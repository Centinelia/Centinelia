# ═══════════════════════════════════════════════════════════════════
# CENTINELIA — Environment Variables (Template)
# Copy to .env.local and fill in actual values for local development.
# ═══════════════════════════════════════════════════════════════════

# ─── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ─── Auth & session secrets ────────────────────────────────────────
ADMIN_SECRET=
PORTAL_SESSION_SECRET=
CRON_SECRET=
# ENCRYPTION_KEY: encripta refresh_tokens OAuth en DB. NO rotar sin plan de re-auth.
ENCRYPTION_KEY=

# ─── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI (LLM) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Vapi (voz + orquestación) ─────────────────────────────────────
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_SERVER_SECRET=
DEMO_AGENT_ID=
DEMO_PERSONALIZADO_AGENT_ID=
# NEXT_PUBLIC_NIA_DEMO_AGENT_ID: ID del agente demo Nia Monterrey (piloto de auto-mode classifier).
# Se remueve el gate NIA_DEMO_ID en Deploy 2, esta env pasa a ser opcional.
NEXT_PUBLIC_NIA_DEMO_AGENT_ID=

# ─── ElevenLabs (voces) ────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
VOICE_ALLOWLIST=

# ─── Twilio (WhatsApp + provisioning números MX) ───────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_REGULATORY_BUNDLE_SID=

# ─── Email ─────────────────────────────────────────────────────────
# Inbound (Resend inbound → webhook)
EMAIL_INBOUND_SECRET=
EMAIL_INBOX_DOMAIN=
# Outbound (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Stripe (billing) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Setup fee (one-time)
STRIPE_SETUP_PRO=
# Plan Pro (roles con voz)
STRIPE_PRO_STARTER=
STRIPE_PRO_GROWTH=
STRIPE_PRO_SCALE=
# Plan Nox (rol Coordinador sin voz — Nox/Niva)
STRIPE_NOX_STARTER=
STRIPE_NOX_GROWTH=
STRIPE_NOX_SCALE=

# ─── OAuth integrations ────────────────────────────────────────────
# Google (Gmail + Drive + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft (Outlook + OneDrive + Calendar)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=
# Intuit / QuickBooks
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=

# ─── Search & rate limiting ───────────────────────────────────────
BRAVE_SEARCH_API_KEY=
# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Analytics ─────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=

# ─── Vercel (auto-managed) ─────────────────────────────────────────
# VERCEL_OIDC_TOKEN se refresca con `vercel link` / `vercel env pull`. No editar a mano.
VERCEL_OIDC_TOKEN=
